    STR_BASE_ES + IDS_ERR_OVERFLW, "Desbordamiento."
    STR_BASE_ES + IDS_ABOUT_TITLE, "Acerca de Calculadora"
    STR_BASE_ES + IDS_ABOUT_L1,    "Calculadora con el estilo de Windows 95"
    STR_BASE_ES + IDS_ABOUT_L2,    "Versión 0.2 (fase 2: Científica)"
    STR_BASE_ES + IDS_ABOUT_L3,    "Copyright © 2026 Juan Sicilia · Licencia MIT"
    STR_BASE_ES + IDS_ABOUT_L4,    "Hecho a mano para Windows 3.1, con nostalgia y amor."
    STR_BASE_ES + IDS_ABOUT_L5,    "Ningún píxel sufrió daños durante su desarrollo."
    STR_BASE_ES + IDS_MODE_ENH,    "Modo extendido del 386"
