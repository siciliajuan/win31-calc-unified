/* calc.rc - resources (converted to Windows-1252 before compiling) */
#include <windows.h>
#include "resource.h"

CALC ICON calc.ico

MENU_EN MENU
BEGIN
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy\tCtrl+C",  IDM_COPY
        MENUITEM "&Paste\tCtrl+V", IDM_PASTE
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Scientific", IDM_SCIENTIFIC
        MENUITEM "S&tandard",   IDM_STANDARD, CHECKED
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Calculator", IDM_ABOUT
    END
END

MENU_ES MENU
BEGIN
    POPUP "&Edición"
    BEGIN
        MENUITEM "&Copiar\tCtrl+C", IDM_COPY
        MENUITEM "&Pegar\tCtrl+V",  IDM_PASTE
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "&Científica", IDM_SCIENTIFIC
        MENUITEM "&Estándar",   IDM_STANDARD, CHECKED
    END
    POPUP "&Ayuda"
    BEGIN
        MENUITEM "&Acerca de Calculadora", IDM_ABOUT
    END
END

/* Same layout as the classic Windows 3.1 "About" box; texts are set at runtime. */
ABOUTBOX DIALOG 0, 0, 262, 128
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 8, "Helv"
BEGIN
    DEFPUSHBUTTON "OK", IDOK, 208, 8, 44, 14
    LTEXT "", IDC_LINE1,   10,  8, 194, 8
    LTEXT "", IDC_LINE2,   10, 18, 194, 8
    LTEXT "", IDC_LINE3,   10, 30, 242, 8
    LTEXT "", IDC_LINE4,   10, 40, 242, 16
    CONTROL "", -1, "Static", SS_BLACKRECT, 10, 60, 242, 1
    LTEXT "", IDC_LINE5,   10, 64, 242, 16
    CONTROL "", -1, "Static", SS_BLACKRECT, 10, 84, 242, 1
    LTEXT "", IDC_MODE,    10, 90, 242, 8
    LTEXT "", IDC_MEMLBL,  10, 100, 85, 8
    LTEXT "", IDC_MEM,     95, 100, 157, 8
    LTEXT "", IDC_RESLBL,  10, 110, 85, 8
    LTEXT "", IDC_RES,     95, 110, 157, 8
END

/* Statistics box (modeless): Windows 95 layout, thin border and native Windows 3.1 buttons. */
STATBOX DIALOG 0, 0, 144, 84
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 8, "Helv"
BEGIN
    LISTBOX IDC_STATLIST, 3, 2, 139, 33, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "&RET", IDC_RET,   3, 57, 28, 14
    PUSHBUTTON "&LOAD",   IDC_LOAD, 39, 57, 28, 14
    PUSHBUTTON "&CD",     IDC_CD,   75, 57, 28, 14
    PUSHBUTTON "C&AD",    IDC_CAD, 111, 57, 28, 14
    CTEXT "", IDC_STATN, 0, 76, 144, 8
END

STRINGTABLE
BEGIN
    STR_BASE_EN + IDS_TITLE,       "Calculator"
    STR_BASE_EN + IDS_BACKSPACE,   "Back"
    STR_BASE_EN + IDS_ERR_DIVZERO, "Cannot divide by zero."
    STR_BASE_EN + IDS_ERR_INVALID, "Invalid input for function."
    STR_BASE_EN + IDS_ERR_OVERFLW, "Overflow."
    STR_BASE_EN + IDS_ABOUT_TITLE, "About Calculator"
    STR_BASE_EN + IDS_ABOUT_L1,    "Windows 95-style Calculator"
    STR_BASE_EN + IDS_ABOUT_L2,    "Version 0.2 (phase 2: Scientific)"
    STR_BASE_EN + IDS_ABOUT_L3,    "Copyright © 2026 Juan Sicilia · MIT License"
    STR_BASE_EN + IDS_ABOUT_L4,    "Handmade for Windows 3.1, with nostalgia and love."
