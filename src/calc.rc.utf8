/* calc.rc - resources (converted to Windows-1252 before compiling) */
#include <windows.h>
#include "resource.h"

CALC ICON calc.ico

MENU_EN MENU
BEGIN
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy\tCtrl+C",  IDM_COPY
        MENUITEM "&Paste\tCtrl+V", IDM_PASTE
    END
    POPUP "&View"
    BEGIN
        MENUITEM "S&tandard",   IDM_STANDARD, CHECKED
        MENUITEM "&Scientific", IDM_SCIENTIFIC, GRAYED
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Calculator", IDM_ABOUT
    END
END

MENU_ES MENU
BEGIN
    POPUP "&Edición"
    BEGIN
        MENUITEM "&Copiar\tCtrl+C", IDM_COPY
        MENUITEM "&Pegar\tCtrl+V",  IDM_PASTE
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "&Estándar",   IDM_STANDARD, CHECKED
        MENUITEM "&Científica", IDM_SCIENTIFIC, GRAYED
    END
    POPUP "&Ayuda"
    BEGIN
        MENUITEM "&Acerca de Calculadora", IDM_ABOUT
    END
END

/* Same layout as the classic Windows 3.1 "About" box; texts are set at runtime. */
ABOUTBOX DIALOG 0, 0, 262, 128
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 8, "Helv"
BEGIN
    DEFPUSHBUTTON "OK", IDOK, 208, 8, 44, 14
    LTEXT "", IDC_ICONPOS, 10, 10, 20, 20, NOT WS_VISIBLE
    LTEXT "", IDC_LINE1,   40,  8, 165, 8
    LTEXT "", IDC_LINE2,   40, 18, 165, 8
    LTEXT "", IDC_LINE3,   40, 30, 215, 8
    LTEXT "", IDC_LINE4,   40, 40, 215, 16
    CONTROL "", -1, "Static", SS_BLACKRECT, 40, 60, 212, 1
    LTEXT "", IDC_LINE5,   40, 64, 215, 16
    CONTROL "", -1, "Static", SS_BLACKRECT, 40, 84, 212, 1
    LTEXT "", IDC_MODE,    40, 90, 210, 8
    LTEXT "", IDC_MEMLBL,  40, 100, 80, 8
    LTEXT "", IDC_MEM,    125, 100, 120, 8
    LTEXT "", IDC_RESLBL,  40, 110, 80, 8
    LTEXT "", IDC_RES,    125, 110, 120, 8
END

STRINGTABLE
BEGIN
    STR_BASE_EN + IDS_TITLE,       "Calculator"
    STR_BASE_EN + IDS_BACKSPACE,   "Back"
    STR_BASE_EN + IDS_ERR_DIVZERO, "Cannot divide by zero."
    STR_BASE_EN + IDS_ERR_INVALID, "Invalid input for function."
    STR_BASE_EN + IDS_ERR_OVERFLW, "Overflow."
    STR_BASE_EN + IDS_ABOUT_TITLE, "About Calculator"
    STR_BASE_EN + IDS_ABOUT_L1,    "Windows 95-style Calculator"
    STR_BASE_EN + IDS_ABOUT_L2,    "Version 0.1 (phase 1: Standard)"
    STR_BASE_EN + IDS_ABOUT_L3,    "Copyright © 2026 Juan Sicilia · MIT License"
    STR_BASE_EN + IDS_ABOUT_L4,    "Handmade for a 486, with nostalgia and Open Watcom."
    STR_BASE_EN + IDS_ABOUT_L5,    "No pixels from 1995 were harmed in the making of this program."
    STR_BASE_EN + IDS_MODE_ENH,    "386 Enhanced Mode"
    STR_BASE_EN + IDS_MODE_STD,    "Standard Mode"
    STR_BASE_EN + IDS_MEM_LABEL,   "Memory:"
    STR_BASE_EN + IDS_MEM_FMT,     "%s KB Free"
    STR_BASE_EN + IDS_RES_LABEL,   "System Resources:"
    STR_BASE_EN + IDS_RES_FMT,     "%u%% Free"
    STR_BASE_EN + IDS_OK,          "OK"

    STR_BASE_ES + IDS_TITLE,       "Calculadora"
    STR_BASE_ES + IDS_BACKSPACE,   "Atrás"
    STR_BASE_ES + IDS_ERR_DIVZERO, "No se puede dividir entre cero."
    STR_BASE_ES + IDS_ERR_INVALID, "Valor no válido para la función."
    STR_BASE_ES + IDS_ERR_OVERFLW, "Desbordamiento."
    STR_BASE_ES + IDS_ABOUT_TITLE, "Acerca de Calculadora"
    STR_BASE_ES + IDS_ABOUT_L1,    "Calculadora estilo 95 para Windows"
    STR_BASE_ES + IDS_ABOUT_L2,    "Versión 0.1 (fase 1: Estándar)"
    STR_BASE_ES + IDS_ABOUT_L3,    "Copyright © 2026 Juan Sicilia · Licencia MIT"
    STR_BASE_ES + IDS_ABOUT_L4,    "Hecha a mano para un 486, con nostalgia y Open Watcom."
    STR_BASE_ES + IDS_ABOUT_L5,    "Ningún píxel de 1995 sufrió daños durante su desarrollo."
    STR_BASE_ES + IDS_MODE_ENH,    "Modo extendido del 386"
    STR_BASE_ES + IDS_MODE_STD,    "Modo estándar"
    STR_BASE_ES + IDS_MEM_LABEL,   "Memoria:"
    STR_BASE_ES + IDS_MEM_FMT,     "%s KB libres"
    STR_BASE_ES + IDS_RES_LABEL,   "Recursos del sistema:"
    STR_BASE_ES + IDS_RES_FMT,     "%u%% libre"
    STR_BASE_ES + IDS_OK,          "Aceptar"
END
